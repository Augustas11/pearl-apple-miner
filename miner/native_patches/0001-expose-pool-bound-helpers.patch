+fn u256_to_py_int<'py>(py: Python<'py>, value: U256) -> PyResult<Bound<'py, PyAny>> {
+    let mut out = [0u8; 32];
+    value.to_little_endian(&mut out);
+    let py_bytes = pyo3::types::PyBytes::new(py, &out);
+    py.get_type::<pyo3::types::PyInt>()
+        .call_method1("from_bytes", (py_bytes, "little"))
+}
+
+#[pyfunction]
+fn nbits_to_difficulty<'py>(py: Python<'py>, nbits: u32) -> PyResult<Bound<'py, PyAny>> {
+    u256_to_py_int(py, proof_utils::nbits_to_difficulty(nbits))
+}
+
+#[pyfunction]
+fn extract_difficulty_bound<'py>(
+    py: Python<'py>,
+    nbits: u32,
+    mining_config: &MiningConfiguration,
+) -> PyResult<Bound<'py, PyAny>> {
+    u256_to_py_int(py, sanity_checks::extract_difficulty_bound(nbits, mining_config))
+}
+

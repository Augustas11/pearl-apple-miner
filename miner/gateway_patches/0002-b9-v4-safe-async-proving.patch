 logger = get_logger(__name__)
 
 
+def _header_identity(template: BlockTemplate) -> dict[str, Any]:
+    header_bytes = template.header.serialize_without_proof_commitment()
+    return {
+        "header_hash": hashlib.blake2s(header_bytes, digest_size=16).hexdigest(),
+        "header_prefix": header_bytes[:8].hex(),
+        "template_height": template.height,
+        "template_time": template.header.timestamp,
+        "cert_version": int(template.required_cert_version),
+    }
+
+
+def _gateway_event(event: str, **fields: Any) -> str:
+    payload = {"event": event, **fields}
+    return json.dumps(payload, sort_keys=True, separators=(",", ":"))
+
+
+def _classify_submission_error(stage: str, exc: BaseException) -> str:
+    if isinstance(exc, (ConnectionError, TimeoutError, asyncio.TimeoutError)):
+        return "transport"
+    if stage == "node":
+        return "transport"
+    return "proving-error"
+
+
+def _classify_submit_result(result: str) -> str:
+    if result == "accepted":
+        return "accepted"
+    lowered = str(result).lower()
+    if "duplicate" in lowered or "already" in lowered:
+        return "duplicate"
+    if "stale" in lowered or "old header" in lowered or "orphan" in lowered:
+        return "stale"
+    if lowered.startswith("rejected:"):
+        return "consensus-invalid"
+    return "transport"
+
+
+def _error_type(exc: BaseException) -> str:
+    return type(exc).__name__
+

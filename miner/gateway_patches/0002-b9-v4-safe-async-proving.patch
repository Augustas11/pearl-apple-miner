+def merkle_branch_for_index(txids: list[str], index: int) -> list[bytes]:
+    """Return internal-byte-order sibling hashes for a transaction Merkle branch."""
+    if not txids:
+        raise ValueError("cannot build Merkle branch for an empty transaction list")
+    if index < 0 or index >= len(txids):
+        raise ValueError("Merkle branch index out of range")
+
+    level = [bytes.fromhex(txid)[::-1] for txid in txids]
+    branch: list[bytes] = []
+    cursor = index
+    while len(level) > 1:
+        sibling = cursor ^ 1
+        if sibling >= len(level):
+            sibling = cursor
+        branch.append(level[sibling])
+
+        next_level = []
+        for i in range(0, len(level), 2):
+            left = level[i]
+            right = level[i + 1] if i + 1 < len(level) else left
+            next_level.append(double_sha256(left + right))
+        level = next_level
+        cursor //= 2
+    return branch
+
